---
// The one layout. Header with the org name, a small nav, the page, a footer with
// the contact and the provenance line. Accent colour comes from site.config.ts.
// No client-side JavaScript — everything here is static HTML and CSS.
import config from "../../site.config.ts";
import { url } from "../lib/url.mjs";
import { meta } from "../lib/published.mjs";

interface Props {
  title?: string;
}
const { title } = Astro.props;
const pageTitle = title ? `${title} · ${config.orgName}` : `${config.orgName} — public records`;
const m = meta();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={`Public records and the "Is it posted?" board for ${config.orgName}.`} />
    <style define:vars={{ accent: config.accent }}>
      :root {
        --accent: var(--accent);
        --fg: #1a1a1a;
        --muted: #5a5a5a;
        --bg: #ffffff;
        --line: #e2e2e2;
        --card: #f7f7f5;
      }
      @media (prefers-color-scheme: dark) {
        :root { --fg: #ececec; --muted: #a9a9a9; --bg: #141414; --line: #333; --card: #1e1e1e; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--fg);
        background: var(--bg);
      }
      main { max-width: 52rem; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
      a { color: var(--accent); }
      header.site {
        max-width: 52rem;
        margin: 0 auto;
        padding: 1.25rem 1.25rem 0;
        border-bottom: 3px solid var(--accent);
      }
      header.site .org { font-size: 1.3rem; font-weight: 700; text-decoration: none; color: var(--fg); }
      nav { margin: 0.75rem 0 1rem; display: flex; gap: 1.25rem; flex-wrap: wrap; }
      nav a { text-decoration: none; }
      footer.site {
        max-width: 52rem; margin: 2rem auto 0; padding: 1rem 1.25rem 2rem;
        border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem;
      }
      h1 { line-height: 1.2; }
      table { border-collapse: collapse; width: 100%; }
      th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); }
      code { background: var(--card); padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.9em; }
      .muted { color: var(--muted); }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 1rem 1.1rem; }
      .notice { border-left: 4px solid var(--accent); padding: 0.6rem 0.9rem; background: var(--card); border-radius: 0 6px 6px 0; }
    </style>
  </head>
  <body>
    <header class="site">
      <a class="org" href={url()}>{config.orgName}</a>
      <nav>
        <a href={url()}>Home</a>
        <a href={url("records/")}>Records</a>
        <a href={url("announcements/")}>Announcements</a>
        <a href={url("board/")}>Is it posted?</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <p>Contact: {config.contact.includes("@") ? <a href={`mailto:${config.contact}`}>{config.contact}</a> : <a href={config.contact}>{config.contact}</a>}</p>
      <p>
        This site is built only from what {config.orgName} has published. Data last fetched{" "}
        {m.fetched_at ? <time datetime={m.fetched_at}>{m.fetched_at}</time> : "— unknown"}.
      </p>
    </footer>
  </body>
</html>
