---
import Base from "../../layouts/Base.astro";
import StateBadge from "../../components/StateBadge.astro";
import { url } from "../../lib/url.mjs";
import { standing, records, meta, bundle } from "../../lib/published.mjs";
import { evaluatedAt, isStale, buildNow, words, FRESH_HOURS } from "../../lib/fresh.mjs";
import type { History } from "../../lib/types";

// THE RULE (carried over from drosera's status page): a missing or unreadable
// standing.json renders as "no data" for everything — never a fake green — and we
// say when the data was last fetched. standing() returns null when the file was
// absent at build time; an empty array means it was published but declares no
// obligations. Those are different states and the board says which.
const rows = standing();
const m = meta();
const corpusIds = new Set(records().map((r) => r.doc_id));

// A row is true only as of when it was evaluated (lib/fresh.mjs). Judged here at
// build time, and again in the reader's browser by the script at the bottom, so
// a page that stops being rebuilt still goes to "unknown" on its own.
const b = bundle();
const publishedAt = b?.published_at ?? null;
const evaluated = evaluatedAt(rows, b);
const stale = isStale(evaluated, buildNow());

function gapPhrase(gap: number | null | undefined) {
  if (gap === null || gap === undefined) return "—";
  if (gap < 0) return `${gap} (${-gap} day${-gap === 1 ? "" : "s"} ahead)`;
  if (gap > 0) return `${gap} (${gap} day${gap === 1 ? "" : "s"} over)`;
  return "0 (on the deadline)";
}

// The track record over a trailing window. A row shows the CURRENT state, so a
// timely posting retires the red that late ones earned; history is what that
// forgets. null is "no history yet" — not a zero-breach pass (invariant 5).
function historyPhrase(h: History | null | undefined) {
  if (!h) return null;
  if (h.breaches > 0) return `late ${h.breaches} of the last ${h.evaluated}`;
  return `none late in the last ${h.evaluated}`;
}
---

<Base title="Is it posted?">
  <h1>Is it posted?</h1>
  <p>
    One row per posting obligation. Each shows its state in words — green, amber,
    red, or no data — the record that satisfies it, the deadline, and the
    server-side time it was published. The last column is the track record: how
    often this rule was posted late over a trailing window, which the current
    state alone cannot show. "No history yet" means there is no past deadline to
    summarise — not a clean record.
  </p>
  <p>
    Last published {publishedAt ? <time datetime={publishedAt}>{words(publishedAt)}</time> : "— unknown"}.
    Evaluated {evaluated ? <time datetime={evaluated}>{words(evaluated)}</time> : "— unknown"}.
    Each row is true as of when it was evaluated. The board is re-checked four
    times a day and on every publish; a board not re-checked for a day shows every
    row as unknown.
  </p>

  {
    rows === null ? (
      <div class="notice">
        <p style="margin-top:0">
          <StateBadge state="no-data" /> The board could not read the vault's
          <code>standing.json</code>. Nothing is shown as met.
        </p>
        <p style="margin-bottom:0" class="muted">
          Data last fetched {m.fetched_at ? <time datetime={m.fetched_at}>{m.fetched_at}</time> : "— unknown"}.
          This is not a passing state — it means the board has no data to show yet.
        </p>
      </div>
    ) : rows.length === 0 ? (
      <p class="notice">No obligations are declared in the vault yet.</p>
    ) : (
      <div id="board" data-evaluated-at={evaluated ?? ""} data-fresh-hours={FRESH_HOURS}>
        <p class="notice stale" hidden={!stale}>
          <StateBadge state="unknown" /> This board has not been re-checked since
          {evaluated ? ` ${words(evaluated)}` : " an unknown time"}, more than a day
          ago, so every row shows unknown. The colour in brackets is what the row
          showed then; it may have changed since. Nothing here is shown as met.
        </p>
        <table>
          <thead>
            <tr>
              <th>Obligation</th>
              <th>State</th>
              <th>Satisfied by</th>
              <th>Deadline</th>
              <th>Published at</th>
              <th>Gap (days)</th>
              <th>Track record</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td><code>{r.id}</code></td>
                <td>
                  <span class="live" hidden={stale}><StateBadge state={r.state} /></span>
                  <span class="stale" hidden={!stale}>
                    <StateBadge state="unknown" /> <span class="muted">(was {r.state === "no-data" ? "no data" : r.state})</span>
                  </span>
                </td>
                <td>
                  {r.satisfied_by ? (
                    corpusIds.has(r.satisfied_by) ? (
                      <a href={url(`records/${r.satisfied_by}/`)}><code>{r.satisfied_by}</code></a>
                    ) : (
                      <code>{r.satisfied_by}</code>
                    )
                  ) : (
                    <span class="muted">—</span>
                  )}
                </td>
                <td>{r.deadline ?? <span class="muted">—</span>}</td>
                <td>{r.published_at ? <time datetime={r.published_at}>{r.published_at}</time> : <span class="muted">—</span>}</td>
                <td>{gapPhrase(r.gap)}</td>
                <td>
                  {historyPhrase(r.history) ?? <span class="muted" title="No past deadline in the window had a receipt-dated outcome. This is not a zero-breach pass.">no history yet</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="muted" style="margin-top:1rem">
          Data last fetched {m.fetched_at ? <time datetime={m.fetched_at}>{m.fetched_at}</time> : "— unknown"}.
          “No data” is not a pass — it means there is nothing to show for that row.
          “Unknown” is not a pass either — it means the board has not been re-checked
          within the day.
        </p>
      </div>
    )
  }
  {/* Runs once, on load. If the board was evaluated more than data-fresh-hours
      ago by the reader's clock (or the page does not say when), it hides every
      colour and shows "unknown". It never does the reverse. */}
  <script is:inline>
    (function () {
      var board = document.getElementById("board");
      if (!board) return;
      var at = Date.parse(board.getAttribute("data-evaluated-at") || "");
      var limit = Number(board.getAttribute("data-fresh-hours")) * 3600000;
      if (!isNaN(at) && limit > 0 && Date.now() - at <= limit) return;
      var live = board.querySelectorAll(".live"), gone = board.querySelectorAll(".stale");
      for (var i = 0; i < live.length; i++) live[i].hidden = true;
      for (var j = 0; j < gone.length; j++) gone[j].hidden = false;
    })();
  </script>
  <style is:global>
    [hidden] { display: none !important; }
  </style>
</Base>
