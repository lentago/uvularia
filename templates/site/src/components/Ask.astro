---
// The Ask box. Rendered only when site.config.ts sets askUrl (pages check
// askUrl() before including this component), so a site without an Ask function
// carries no widget markup and no script.
//
// Progressive enhancement: the HTML ships with a link to the records index and
// the form hidden. The script reveals the form and hides the link; with
// JavaScript off, the reader gets the link and nothing that half-works.
//
// The script sends exactly one thing — {"question": "..."} — with no cookies and
// no referrer, logs nothing, and keeps the transcript in sessionStorage (gone
// when the tab closes). Rendering lives in lib/ask.mjs so it can be tested
// without a browser. The style block is inline so a site without an Ask box
// carries none of it.
import { url } from "../lib/url.mjs";
import { records } from "../lib/published.mjs";
import { askUrl, askDisclaimer } from "../lib/ask-config.mjs";

const endpoint = askUrl();
const disclaimer = askDisclaimer();
const recordsBase = url("records/");
// The ids this site has a page for, so a citation links only where a page exists.
const knownIds = JSON.stringify(records().map((r) => r.doc_id)).replace(/</g, "\\u003c");
---

<section class="ask card" data-ask data-ask-url={endpoint} data-records-base={recordsBase}>
  <h2 style="margin-top:0">Ask the records</h2>
  <p data-ask-fallback>
    Looking for something? <a href={recordsBase}>Browse the records index</a>.
  </p>
  <form hidden data-ask-form>
    <label for="ask-question">Ask a question about what has been published. Answers cite the records they come from.</label>
    <textarea id="ask-question" name="question" rows="3" maxlength="1000" required></textarea>
    <div class="ask-actions">
      <button type="submit">Ask</button>
      <button type="button" data-ask-clear>Clear this conversation</button>
      <span class="muted" data-ask-pending aria-live="polite"></span>
    </div>
  </form>
  <div data-ask-log aria-live="polite"></div>
  {disclaimer && <p class="muted ask-disclaimer">{disclaimer}</p>}
  <script type="application/json" data-ask-ids set:html={knownIds} />
</section>

<style is:inline>
  .ask textarea { width: 100%; font: inherit; padding: 0.5rem; margin: 0.4rem 0; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--fg); }
  .ask-actions { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  .ask button { font: inherit; padding: 0.35rem 0.9rem; border-radius: 6px; border: 1px solid var(--accent); background: var(--accent); color: #fff; cursor: pointer; }
  .ask button[data-ask-clear] { background: transparent; color: var(--accent); }
  .ask button:disabled { opacity: 0.6; cursor: wait; }
  .ask-turn { border-top: 1px solid var(--line); margin-top: 1rem; padding-top: 0.75rem; }
  .ask-word { display: inline-block; font-weight: 700; padding: 0 0.5em; margin-right: 0.35em; border: 1px solid currentColor; border-radius: 4px; }
  .ask-banner { border-left: 4px solid #b26a00; background: var(--card); padding: 0.6rem 0.9rem; border-radius: 0 6px 6px 0; }
  .ask-banner p { margin: 0.25rem 0; }
  .ask-disclaimer { font-size: 0.85rem; margin-bottom: 0; }
</style>

<script>
  import { renderTurn } from "../lib/ask.mjs";

  const KEY = "uvularia-ask-transcript";
  const MAX_TURNS = 20;
  const TIMEOUT_MS = 60000;

  // Keep only the reply contract's fields; nothing else is stored or shown.
  function pick(body) {
    if (!body || typeof body !== "object") return null;
    const { kind, reply, source_ids, degraded_signals } = body;
    return { kind, reply, source_ids, degraded_signals };
  }

  function load() {
    try {
      const turns = JSON.parse(sessionStorage.getItem(KEY) || "[]");
      return Array.isArray(turns) ? turns : [];
    } catch {
      return [];
    }
  }

  function save(turns) {
    try {
      if (turns.length) sessionStorage.setItem(KEY, JSON.stringify(turns));
      else sessionStorage.removeItem(KEY);
    } catch {
      // Storage off (private mode, full): the transcript lasts until reload.
    }
  }

  async function ask(endpoint, question) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ question }),
        credentials: "omit",
        referrerPolicy: "no-referrer",
        cache: "no-store",
        signal: controller.signal,
      });
      let body = null;
      try {
        body = await res.json();
      } catch {
        body = null;
      }
      return { status: res.status, body: pick(body) };
    } catch {
      // Unreachable or too slow: status 0 renders as "the Ask box is off".
      return { status: 0, body: null };
    } finally {
      clearTimeout(timer);
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-ask]")) {
    const endpoint = root.dataset.askUrl || "";
    const form = root.querySelector<HTMLFormElement>("[data-ask-form]");
    const input = root.querySelector<HTMLTextAreaElement>("textarea");
    const submit = root.querySelector<HTMLButtonElement>('button[type="submit"]');
    const clear = root.querySelector<HTMLButtonElement>("[data-ask-clear]");
    const pending = root.querySelector<HTMLElement>("[data-ask-pending]");
    const log = root.querySelector<HTMLElement>("[data-ask-log]");
    const fallback = root.querySelector<HTMLElement>("[data-ask-fallback]");
    if (!endpoint || !form || !input || !submit || !clear || !pending || !log) continue;

    let knownIds: string[] = [];
    try {
      knownIds = JSON.parse(root.querySelector("[data-ask-ids]")?.textContent || "[]");
    } catch {
      knownIds = [];
    }
    const ctx = { recordsBase: root.dataset.recordsBase || "", knownIds: new Set(knownIds) };

    let turns = load();
    const draw = () => {
      log.innerHTML = turns.map((t) => renderTurn(t, ctx)).join("");
      clear.hidden = turns.length === 0;
    };

    form.hidden = false;
    if (fallback) fallback.hidden = true;
    draw();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (!question) return;
      submit.disabled = true;
      pending.textContent = "Looking through the records…";
      const { status, body } = await ask(endpoint, question);
      turns = [...turns, { question, status, body }].slice(-MAX_TURNS);
      save(turns);
      draw();
      input.value = "";
      pending.textContent = "";
      submit.disabled = false;
      log.lastElementChild?.scrollIntoView({ block: "nearest" });
    });

    clear.addEventListener("click", () => {
      turns = [];
      save(turns);
      draw();
    });
  }
</script>
