---
// A compliance state shown as a WORD with a colour behind it — never colour
// alone (accessibility, and the board's whole point is to be read, not decoded).
// The four states come straight from standing.schema.json. "unknown" is not one
// of them: it is what a row shows when the board has not been re-checked within
// the day (lib/fresh.mjs), and it hides the last colour rather than vouch for it.
import type { State } from "../lib/types";

type Shown = State | "unknown";

interface Props {
  state: Shown;
}
const { state } = Astro.props;
const WORDS: Record<Shown, string> = { green: "green", amber: "amber", red: "red", "no-data": "no data", unknown: "unknown" };
const COLOURS: Record<Shown, { bg: string; fg: string }> = {
  green: { bg: "#1b7a3d", fg: "#ffffff" },
  amber: { bg: "#b36b00", fg: "#ffffff" },
  red: { bg: "#b3261e", fg: "#ffffff" },
  "no-data": { bg: "#6a6a6a", fg: "#ffffff" },
  unknown: { bg: "#6a6a6a", fg: "#ffffff" },
};
const word = WORDS[state] ?? state;
const c = COLOURS[state] ?? COLOURS["no-data"];
---

<span
  class="badge"
  style={`background:${c.bg};color:${c.fg}`}
  role="status"
  aria-label={`state: ${word}`}
>{word}</span>

<style>
  .badge {
    display: inline-block;
    padding: 0.12em 0.6em;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
  }
</style>
